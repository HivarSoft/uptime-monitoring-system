# ─── Server ───────────────────────────────────────────────────────────────────
PORT=911
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/uptime?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/uptime
MongoDBURL=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/uptime?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Access token secret (short-lived, 1h)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# Refresh token secret (long-lived, 30d) — keep separate from JWT_SECRET
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_at_least_64_chars

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:911/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:911/api/v1/auth/google/callback

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create app at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:911/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:911/api/v1/auth/github/callback

# ─── Redis (required for BullMQ queue) ───────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── BullMQ worker concurrency ────────────────────────────────────────────────
WORKER_CONCURRENCY=50

# ─── CORS / Frontend ──────────────────────────────────────────────────────────
# Development frontend (Vite default port)
# FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://your-frontend.example.com
FRONTEND_URL=

# ─── Quick-start (local) ──────────────────────────────────────────────────────
# 1. Start Redis:  docker run -p 6379:6379 redis:7-alpine
# 2. cp backend/.env.example backend/.env   — fill all values above
# 3. Register Google & GitHub OAuth apps with the callback URLs above
# 4. cd backend && npm install && npm run dev
# 5. cd frontend && npm install && npm run dev  → http://localhost:5173
